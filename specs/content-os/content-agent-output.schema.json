{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamislands.org/schemas/content-agent-output.schema.json",
  "title": "Dream Islands Content Agent Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "brief", "story", "caption", "assets", "claims", "qa", "publication"],
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_item_id", "sequence", "layer"],
      "properties": {
        "plan_item_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "layer": {"enum": ["brand", "need", "intelligence", "destination", "programme", "conversion"]}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "channel", "format", "locale", "market", "hook", "cta"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "channel": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 2},
        "market": {"type": "string", "minLength": 1},
        "hook": {"type": "string", "minLength": 1},
        "cta": {"type": "string", "minLength": 1},
        "ws_focus": {"type": ["string", "null"]},
        "ws_dimensions": {"type": "array", "items": {"type": "string"}},
        "ws_stage": {"enum": ["awareness", "assessment", "consideration", "conversion", "medical", null]}
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_question", "units"],
      "properties": {
        "primary_question": {"type": "string", "minLength": 1},
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "role", "headline", "body", "layout_family", "visual_intent", "claim_ids"],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "role": {"enum": ["hook", "problem", "need", "insight", "discovery", "match", "evidence", "specifics", "cta"]},
              "headline": {"type": "string"},
              "body": {"type": "string"},
              "layout_family": {"type": "string", "minLength": 1},
              "visual_intent": {"type": "string", "minLength": 1},
              "claim_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "caption": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "source", "role", "reality"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "source": {"enum": ["supabase", "supplier", "brand", "generated_editorial"]},
          "role": {"type": "string", "minLength": 1},
          "reality": {"enum": ["real", "editorial_concept"]},
          "crop_intent": {"type": ["string", "null"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "text", "status", "source_ref"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed", "hypothesis", "missing"]},
          "source_ref": {"type": ["string", "null"]}
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "narrative", "visual", "human_review_required"],
      "properties": {
        "fact": {"enum": ["pass", "fail"]},
        "narrative": {"enum": ["pass", "fail"]},
        "visual": {"enum": ["pass", "fail"]},
        "human_review_required": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "renderer_ready"],
      "properties": {
        "recommendation": {"enum": ["hold", "human_review", "ready"]},
        "renderer_ready": {"type": "boolean"}
      }
    }
  }
}
